# Turso database credentials.
# Create one database for dev and a separate one for prod on turso.tech,
# then copy this file to .env.local (dev) and fill in the values.
DATABASE_URL="libsql://<your-db-name>-<org>.turso.io"
DATABASE_AUTH_TOKEN="<your-turso-auth-token>"

# Cloudinary (free tier, no card required) for posters/videos/avatars.
# Sign up at cloudinary.com, then copy these 3 values from your Dashboard home page.
CLOUDINARY_CLOUD_NAME="<your-cloud-name>"
CLOUDINARY_API_KEY="<your-api-key>"
CLOUDINARY_API_SECRET="<your-api-secret>"
